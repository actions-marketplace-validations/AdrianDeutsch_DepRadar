<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DepRadar.Cli</RootNamespace>

    <!-- Packaged as a .NET global tool: `dotnet tool install ... && depradar scan ...`.
         The CLI runs the stateless analyzer, so it needs no server and no database. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>depradar</ToolCommandName>

    <!-- `dotnet publish -p:StandaloneBinary=true` produces the SDK-free release binary
         (self-contained single file named `depradar`). Conditional because a bare
         `-p:AssemblyName=` on the CLI would apply to every project in the graph. -->
    <PackAsTool Condition="'$(StandaloneBinary)' == 'true'">false</PackAsTool>
    <AssemblyName Condition="'$(StandaloneBinary)' == 'true'">depradar</AssemblyName>
    <PublishSingleFile Condition="'$(StandaloneBinary)' == 'true'">true</PublishSingleFile>
    <SelfContained Condition="'$(StandaloneBinary)' == 'true'">true</SelfContained>
    <!-- Compression is deliberately OFF: with EnableCompressionInSingleFile the runtime
         intermittently dies with an AccessViolationException in System.Text.Json's
         type-metadata init when the analyzer's 8 concurrent advisory lookups hit the
         first JSON serialization together (reproduced 5/5 on go/cargo scans; 10/10
         stable uncompressed). ~86 MB vs ~38 MB is the price of a binary that works. -->
    <EnableCompressionInSingleFile Condition="'$(StandaloneBinary)' == 'true'">false</EnableCompressionInSingleFile>
    <PackageId>DepRadar.Tool</PackageId>
    <Version>0.9.0</Version>
    <Authors>Adrian Deutsch</Authors>
    <Description>Dependency-health CLI: scan a NuGet package or project for security, license and maintenance risk, fail CI on policy violations, and auto-fix vulnerable dependencies (incl. transitive) with a pull request.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/nupkg</PackageOutputPath>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AdrianDeutsch/DepRadar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdrianDeutsch/DepRadar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>security;dependencies;vulnerabilities;sbom;sarif;cli;dotnet-tool;supply-chain;nuget</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DepRadar.Application\DepRadar.Application.csproj" />
    <ProjectReference Include="..\DepRadar.Infrastructure\DepRadar.Infrastructure.csproj" />
  </ItemGroup>

</Project>
